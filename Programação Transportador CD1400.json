    {
      "parameters": {
        "jsCode": "// Este código roda para cada item do array vindo do Excel\nreturn items.map(item => {\n  const excelSerial = item.json['DATA ENTREGA'];\n\n  // Se não houver número, apenas retorna o item original\n  if (!excelSerial) {\n    return item;\n  }\n\n  // Base do Excel: 1900-01-01\n  const baseDate = new Date(1900, 0, 1);\n\n  // Ajuste do bug do Excel (ano 1900 considerado bissexto)\n  const jsDate = new Date(baseDate.getTime() + (excelSerial - 2) * 24 * 60 * 60 * 1000);\n\n  // Formatar para ISO (YYYY-MM-DD)\n  const dia = jsDate.getDate().toString().padStart(2, '0');\n  const mes = (jsDate.getMonth() + 1).toString().padStart(2, '0');\n  const ano = jsDate.getFullYear();\n  const dataISO = `${ano}-${mes}-${dia}`;\n\n  // Formatar para BR (DD/MM/YYYY)\n  const dataBR = `${dia}/${mes}/${ano}`;\n\n  // Retorna todas as colunas originais + as datas convertidas\n  return {\n    json: {\n      ...item.json,\n      'DATA ENTREGA ISO': dataISO,\n      'DATA ENTREGA BR': dataBR\n    }\n  };\n});\n"
      },
